# ─── Kalshi API Credentials ───────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Get your key ID from https://kalshi.com/settings → API Keys
# Then generate an RSA keypair and upload the PUBLIC key to Kalshi.

KALSHI_API_KEY_ID=your-key-id-here

# Path to your RSA private key PEM file (e.g. ~/kalshi_private_key.pem)
# OR paste the raw PEM content in KALSHI_PRIVATE_KEY below.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# Use "demo" to hit the sandbox, "prod" for real money
KALSHI_ENV=demo
